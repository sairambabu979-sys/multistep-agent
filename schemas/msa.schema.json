{
  "$defs": {
    "AdmissionConfig": {
      "additionalProperties": false,
      "description": "CREATED (ADR-015): what a run may ask for before any work starts.",
      "properties": {
        "max_budget_usd": {
          "default": 50.0,
          "exclusiveMinimum": 0,
          "title": "Max Budget Usd",
          "type": "number"
        },
        "max_live_runs": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Max Live Runs",
          "type": "integer"
        },
        "max_wall_clock_minutes": {
          "default": 240,
          "exclusiveMinimum": 0,
          "title": "Max Wall Clock Minutes",
          "type": "integer"
        }
      },
      "title": "AdmissionConfig",
      "type": "object"
    },
    "AgentsConfig": {
      "additionalProperties": false,
      "description": "Bounds on one agent invocation, on top of its effect's budget reservation.",
      "properties": {
        "arbiter_max_turns": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Arbiter Max Turns",
          "type": "integer"
        },
        "author_max_turns": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Author Max Turns",
          "type": "integer"
        },
        "coder_max_turns": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Coder Max Turns",
          "type": "integer"
        },
        "planner_max_turns": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Planner Max Turns",
          "type": "integer"
        },
        "repo_map_max_paths": {
          "default": 400,
          "exclusiveMinimum": 0,
          "title": "Repo Map Max Paths",
          "type": "integer"
        },
        "repro_max_turns": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Repro Max Turns",
          "type": "integer"
        },
        "reviewer_max_turns": {
          "default": 40,
          "exclusiveMinimum": 0,
          "title": "Reviewer Max Turns",
          "type": "integer"
        },
        "tester_max_turns": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Tester Max Turns",
          "type": "integer"
        },
        "triage_max_turns": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Triage Max Turns",
          "type": "integer"
        }
      },
      "title": "AgentsConfig",
      "type": "object"
    },
    "ApiConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "pattern": "^https://[a-z0-9.-]+(:\\d+)?/?$",
          "title": "Base Url",
          "type": "string"
        },
        "betas": {
          "$ref": "#/$defs/BetasConfig"
        },
        "fallbacks": {
          "title": "Fallbacks",
          "type": "string"
        },
        "max_retries": {
          "default": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "min_output_tokens": {
          "default": 1024,
          "exclusiveMinimum": 0,
          "title": "Min Output Tokens",
          "type": "integer"
        },
        "retry_backoff_seconds": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Retry Backoff Seconds",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "max_tokens",
        "fallbacks",
        "betas"
      ],
      "title": "ApiConfig",
      "type": "object"
    },
    "BetasConfig": {
      "additionalProperties": false,
      "properties": {
        "server_side_fallback": {
          "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}$",
          "title": "Server Side Fallback",
          "type": "string"
        },
        "task_budgets": {
          "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}$",
          "title": "Task Budgets",
          "type": "string"
        },
        "thinking_binding": {
          "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}$",
          "title": "Thinking Binding",
          "type": "string"
        }
      },
      "required": [
        "server_side_fallback",
        "task_budgets",
        "thinking_binding"
      ],
      "title": "BetasConfig",
      "type": "object"
    },
    "CapabilitiesConfig": {
      "additionalProperties": false,
      "properties": {
        "protected": {
          "default": [
            "**/.git",
            "**/.git/**",
            ".msa",
            ".msa/**"
          ],
          "items": {
            "type": "string"
          },
          "title": "Protected",
          "type": "array"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleCapability"
          },
          "propertyNames": {
            "$ref": "#/$defs/Role"
          },
          "title": "Roles",
          "type": "object"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "ContainerConfig": {
      "additionalProperties": false,
      "description": "The container backend for repository commands (ADR-019): the ``run`` tool and the\ntest gates run in a fresh container per command, with the worktree mounted and\nnothing else writable, no network, a non-root user, and CPU, memory and process\nlimits. ``image`` must hold the repository's toolchain (pytest, ruff, mypy, and its\ndependencies): nothing is installed in the container, which has no network to do it.",
      "properties": {
        "cpus": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Cpus",
          "type": "number"
        },
        "image": {
          "default": "",
          "title": "Image",
          "type": "string"
        },
        "launcher": {
          "default": [
            "python",
            "-m"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Launcher",
          "type": "array"
        },
        "memory": {
          "default": "4g",
          "pattern": "^[1-9][0-9]*[kmg]$",
          "title": "Memory",
          "type": "string"
        },
        "pids_limit": {
          "default": 512,
          "exclusiveMinimum": 0,
          "title": "Pids Limit",
          "type": "integer"
        },
        "runtime": {
          "default": "docker",
          "enum": [
            "docker",
            "podman"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "tmp_size": {
          "default": "512m",
          "pattern": "^[1-9][0-9]*[kmg]$",
          "title": "Tmp Size",
          "type": "string"
        },
        "user": {
          "default": "",
          "pattern": "^([1-9][0-9]*:[0-9]+)?$",
          "title": "User",
          "type": "string"
        }
      },
      "title": "ContainerConfig",
      "type": "object"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "Escalation": {
      "description": "Who rules on findings the negotiation could not settle.",
      "enum": [
        "human",
        "arbiter"
      ],
      "title": "Escalation",
      "type": "string"
    },
    "IntegrationConfig": {
      "additionalProperties": false,
      "description": "INTEGRATION_TESTING (ADR-015): the repository's integration suite.",
      "properties": {
        "isolate_network": {
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "title": "Isolate Network",
          "type": "string"
        },
        "paths": {
          "default": [
            "tests/integration"
          ],
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        }
      },
      "title": "IntegrationConfig",
      "type": "object"
    },
    "JournalConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "default": ".msa/runs.db",
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "schema_name": {
          "default": "msa",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "title": "Schema Name",
          "type": "string"
        },
        "snapshot_every": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Snapshot Every",
          "type": "integer"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "JournalConfig",
      "type": "object"
    },
    "LimitsConfig": {
      "additionalProperties": false,
      "description": "Defaults for every run. The loop bounds default to the core's own defaults, which are\nthe limits the state machine is exhaustively model-checked at.",
      "properties": {
        "budget_usd": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Budget Usd",
          "type": "number"
        },
        "escalation": {
          "$ref": "#/$defs/Escalation",
          "default": "human"
        },
        "max_negotiation_rounds": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Max Negotiation Rounds",
          "type": "integer"
        },
        "max_replans": {
          "default": 2,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "max_revisions": {
          "default": 4,
          "minimum": 0,
          "title": "Max Revisions",
          "type": "integer"
        },
        "plan_gate": {
          "$ref": "#/$defs/PlanGate",
          "default": "auto"
        },
        "wall_clock_minutes": {
          "default": 45,
          "exclusiveMinimum": 0,
          "title": "Wall Clock Minutes",
          "type": "integer"
        }
      },
      "title": "LimitsConfig",
      "type": "object"
    },
    "ModelsConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "pattern": "^claude-[a-z]+(?:-\\d{1,2})+$",
          "title": "Default",
          "type": "string"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleConfig"
          },
          "propertyNames": {
            "$ref": "#/$defs/Role"
          },
          "title": "Roles",
          "type": "object"
        }
      },
      "required": [
        "default",
        "roles"
      ],
      "title": "ModelsConfig",
      "type": "object"
    },
    "ObservabilityConfig": {
      "additionalProperties": false,
      "description": "Traces (ADR-015 \u00a73): one span per effect, invocation and tool call. ``console``\nwrites finished spans to stderr; ``none`` makes them free no-ops.",
      "properties": {
        "traces": {
          "default": "none",
          "enum": [
            "none",
            "console"
          ],
          "title": "Traces",
          "type": "string"
        }
      },
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "PlanGate": {
      "description": "Whether a produced plan needs a human's approval before building starts.",
      "enum": [
        "auto",
        "human"
      ],
      "title": "PlanGate",
      "type": "string"
    },
    "Pricing": {
      "additionalProperties": false,
      "description": "US dollars per million tokens, as published.",
      "properties": {
        "cache_read": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Cache Read"
        },
        "cache_write_1h": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Cache Write 1H"
        },
        "cache_write_5m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Cache Write 5M"
        },
        "input": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Input"
        },
        "output": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Output"
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write_5m",
        "cache_write_1h"
      ],
      "title": "Pricing",
      "type": "object"
    },
    "PublishConfig": {
      "additionalProperties": false,
      "description": "What happens to an approved release after it is committed to its local branch\n(ADR-018). ``msa approve --publish`` overrides ``mode`` for one approval.\n\nThe push uses git's own credentials (a credential helper or SSH key). The pull request\nuses ``gh`` when it is installed and logged in, otherwise the REST API with the token in\nthe variable ``token_env`` names; the token is never written anywhere.",
      "properties": {
        "api_url": {
          "default": "https://api.github.com",
          "pattern": "^https?://[^\\s]+$",
          "title": "Api Url",
          "type": "string"
        },
        "base": {
          "default": "",
          "title": "Base",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/PublishMode",
          "default": "local"
        },
        "remote": {
          "default": "origin",
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Remote",
          "type": "string"
        },
        "repository": {
          "default": "",
          "pattern": "^([\\w.-]+/[\\w.-]+)?$",
          "title": "Repository",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "token_env": {
          "default": "GITHUB_TOKEN",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Token Env",
          "type": "string"
        }
      },
      "title": "PublishConfig",
      "type": "object"
    },
    "PublishMode": {
      "description": "What happens to an approved release once it is committed to its local branch\n(ADR-018). Chosen by the person who approves, and recorded with the approval.",
      "enum": [
        "local",
        "push",
        "pr"
      ],
      "title": "PublishMode",
      "type": "string"
    },
    "ReleaseConfig": {
      "additionalProperties": false,
      "description": "FINAL_VERIFICATION and publishing (ADR-015).",
      "properties": {
        "branch_prefix": {
          "default": "aegis/",
          "pattern": "^[a-z0-9][a-z0-9/_-]*/$",
          "title": "Branch Prefix",
          "type": "string"
        }
      },
      "title": "ReleaseConfig",
      "type": "object"
    },
    "ReviewConfig": {
      "additionalProperties": false,
      "description": "REVIEWING and NEGOTIATING (PLAN \u00a74, ADR-014).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "ReviewConfig",
      "type": "object"
    },
    "Role": {
      "enum": [
        "planner",
        "coder",
        "tester",
        "reviewer",
        "arbiter"
      ],
      "title": "Role",
      "type": "string"
    },
    "RoleCapability": {
      "additionalProperties": false,
      "description": "What one role may write: paths matching ``write`` and not ``deny``.",
      "properties": {
        "deny": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        },
        "write": {
          "items": {
            "type": "string"
          },
          "title": "Write",
          "type": "array"
        }
      },
      "required": [
        "write"
      ],
      "title": "RoleCapability",
      "type": "object"
    },
    "RoleConfig": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^claude-[a-z]+(?:-\\d{1,2})+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "effort"
      ],
      "title": "RoleConfig",
      "type": "object"
    },
    "SandboxConfig": {
      "additionalProperties": false,
      "description": "How commands run in the worktree sandbox (PLAN \u00a78, ADR-009, ADR-019).",
      "properties": {
        "backend": {
          "default": "local",
          "enum": [
            "local",
            "container"
          ],
          "title": "Backend",
          "type": "string"
        },
        "container": {
          "$ref": "#/$defs/ContainerConfig",
          "default": {
            "cpus": 2.0,
            "image": "",
            "launcher": [
              "python",
              "-m"
            ],
            "memory": "4g",
            "pids_limit": 512,
            "runtime": "docker",
            "tmp_size": "512m",
            "user": ""
          }
        },
        "cpu_seconds": {
          "default": 1800,
          "exclusiveMinimum": 0,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "env_passthrough": {
          "default": [
            "PATH",
            "HOME",
            "LANG",
            "LC_ALL",
            "TMPDIR",
            "TERM"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "isolate_network": {
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "title": "Isolate Network",
          "type": "string"
        },
        "launcher": {
          "default": [
            "uv",
            "run",
            "--frozen",
            "python",
            "-m"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Launcher",
          "type": "array"
        },
        "max_file_bytes": {
          "default": 1073741824,
          "exclusiveMinimum": 0,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "output_limit_bytes": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "title": "Output Limit Bytes",
          "type": "integer"
        },
        "read_limit_bytes": {
          "default": 2097152,
          "exclusiveMinimum": 0,
          "title": "Read Limit Bytes",
          "type": "integer"
        },
        "search_limit_matches": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Search Limit Matches",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "view_limit_chars": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "View Limit Chars",
          "type": "integer"
        }
      },
      "title": "SandboxConfig",
      "type": "object"
    },
    "SecurityConfig": {
      "additionalProperties": false,
      "description": "SECURITY_REVIEW (ADR-015): deterministic rules over what the change adds.",
      "properties": {
        "audit_command": {
          "default": [
            "pip-audit"
          ],
          "items": {
            "type": "string"
          },
          "title": "Audit Command",
          "type": "array"
        },
        "audit_timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "title": "Audit Timeout Seconds",
          "type": "number"
        },
        "forbid_new_dependencies": {
          "default": false,
          "title": "Forbid New Dependencies",
          "type": "boolean"
        }
      },
      "title": "SecurityConfig",
      "type": "object"
    },
    "ServiceConfig": {
      "additionalProperties": false,
      "description": "``msa serve`` (ADR-015 \u00a73): the HTTP API.",
      "properties": {
        "cors_origins": {
          "default": [],
          "items": {
            "pattern": "^https?://[^/\\s]+$",
            "type": "string"
          },
          "title": "Cors Origins",
          "type": "array"
        },
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8765,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "ServiceConfig",
      "type": "object"
    },
    "TemporalConfig": {
      "additionalProperties": false,
      "description": "Driving runs with Temporal (ADR-017). With no ``address``, runs are driven in the\nprocess that starts or answers them; with one, ``msa worker`` drives them, and answers\nreach a run's workflow as signals.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "namespace": {
          "default": "default",
          "title": "Namespace",
          "type": "string"
        },
        "task_queue": {
          "default": "aegis",
          "title": "Task Queue",
          "type": "string"
        }
      },
      "title": "TemporalConfig",
      "type": "object"
    },
    "TestingConfig": {
      "additionalProperties": false,
      "description": "TESTING (PLAN \u00a76.1): how failures are told apart.",
      "properties": {
        "flake_reruns": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Flake Reruns",
          "type": "integer"
        },
        "repro_directory": {
          "default": "tests/repro",
          "title": "Repro Directory",
          "type": "string"
        }
      },
      "title": "TestingConfig",
      "type": "object"
    },
    "VerifyCommand": {
      "enum": [
        "pytest",
        "ruff_check",
        "ruff_format_check",
        "mypy"
      ],
      "type": "string"
    },
    "VerifyConfig": {
      "additionalProperties": false,
      "description": "STATIC_ANALYSIS (ADR-015): deterministic checks on the head tree, in this order. Each\nruns over the whole worktree. Hard preference checks always run as well. Tests do not\nrun here: UNIT_TESTING and INTEGRATION_TESTING run them, and judge their failures.",
      "properties": {
        "commands": {
          "default": [
            "ruff_check",
            "ruff_format_check",
            "mypy"
          ],
          "items": {
            "$ref": "#/$defs/VerifyCommand"
          },
          "title": "Commands",
          "type": "array"
        }
      },
      "title": "VerifyConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "$ref": "#/$defs/AdmissionConfig",
      "default": {
        "max_budget_usd": 50.0,
        "max_live_runs": 4,
        "max_wall_clock_minutes": 240
      }
    },
    "agents": {
      "$ref": "#/$defs/AgentsConfig",
      "default": {
        "arbiter_max_turns": 4,
        "author_max_turns": 20,
        "coder_max_turns": 60,
        "planner_max_turns": 30,
        "repo_map_max_paths": 400,
        "repro_max_turns": 30,
        "reviewer_max_turns": 40,
        "tester_max_turns": 60,
        "triage_max_turns": 20
      }
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesConfig",
      "default": {
        "protected": [
          "**/.git",
          "**/.git/**",
          ".msa",
          ".msa/**"
        ],
        "roles": {
          "arbiter": {
            "deny": [],
            "write": []
          },
          "coder": {
            "deny": [
              "tests/acceptance/**",
              "tests/repro/**"
            ],
            "write": [
              "**"
            ]
          },
          "planner": {
            "deny": [],
            "write": []
          },
          "reviewer": {
            "deny": [],
            "write": []
          },
          "tester": {
            "deny": [],
            "write": [
              "tests/acceptance/**",
              "tests/repro/**"
            ]
          }
        }
      }
    },
    "integration": {
      "$ref": "#/$defs/IntegrationConfig",
      "default": {
        "isolate_network": "auto",
        "paths": [
          "tests/integration"
        ]
      }
    },
    "journal": {
      "$ref": "#/$defs/JournalConfig",
      "default": {
        "path": ".msa/runs.db",
        "schema_name": "msa",
        "snapshot_every": 50,
        "url": null
      }
    },
    "limits": {
      "$ref": "#/$defs/LimitsConfig",
      "default": {
        "budget_usd": 5.0,
        "escalation": "human",
        "max_negotiation_rounds": 3,
        "max_replans": 2,
        "max_revisions": 4,
        "plan_gate": "auto",
        "wall_clock_minutes": 45
      }
    },
    "models": {
      "$ref": "#/$defs/ModelsConfig"
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "traces": "none"
      }
    },
    "pricing": {
      "patternProperties": {
        "^claude-[a-z]+(?:-\\d{1,2})+$": {
          "$ref": "#/$defs/Pricing"
        }
      },
      "title": "Pricing",
      "type": "object"
    },
    "publish": {
      "$ref": "#/$defs/PublishConfig",
      "default": {
        "api_url": "https://api.github.com",
        "base": "",
        "mode": "local",
        "remote": "origin",
        "repository": "",
        "timeout_seconds": 60.0,
        "token_env": "GITHUB_TOKEN"
      }
    },
    "release": {
      "$ref": "#/$defs/ReleaseConfig",
      "default": {
        "branch_prefix": "aegis/"
      }
    },
    "review": {
      "$ref": "#/$defs/ReviewConfig",
      "default": {
        "enabled": true
      }
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxConfig",
      "default": {
        "backend": "local",
        "container": {
          "cpus": 2.0,
          "image": "",
          "launcher": [
            "python",
            "-m"
          ],
          "memory": "4g",
          "pids_limit": 512,
          "runtime": "docker",
          "tmp_size": "512m",
          "user": ""
        },
        "cpu_seconds": 1800,
        "env_passthrough": [
          "PATH",
          "HOME",
          "LANG",
          "LC_ALL",
          "TMPDIR",
          "TERM"
        ],
        "isolate_network": "auto",
        "launcher": [
          "uv",
          "run",
          "--frozen",
          "python",
          "-m"
        ],
        "max_file_bytes": 1073741824,
        "output_limit_bytes": 65536,
        "read_limit_bytes": 2097152,
        "search_limit_matches": 200,
        "timeout_seconds": 600.0,
        "view_limit_chars": 100000
      }
    },
    "security": {
      "$ref": "#/$defs/SecurityConfig",
      "default": {
        "audit_command": [
          "pip-audit"
        ],
        "audit_timeout_seconds": 120.0,
        "forbid_new_dependencies": false
      }
    },
    "service": {
      "$ref": "#/$defs/ServiceConfig",
      "default": {
        "cors_origins": [],
        "host": "127.0.0.1",
        "port": 8765
      }
    },
    "temporal": {
      "$ref": "#/$defs/TemporalConfig",
      "default": {
        "address": null,
        "namespace": "default",
        "task_queue": "aegis"
      }
    },
    "testing": {
      "$ref": "#/$defs/TestingConfig",
      "default": {
        "flake_reruns": 3,
        "repro_directory": "tests/repro"
      }
    },
    "verify": {
      "$ref": "#/$defs/VerifyConfig",
      "default": {
        "commands": [
          "ruff_check",
          "ruff_format_check",
          "mypy"
        ]
      }
    }
  },
  "required": [
    "models",
    "api",
    "pricing"
  ],
  "title": "msa.toml",
  "type": "object"
}
